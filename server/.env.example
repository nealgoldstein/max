# Local dev — copy to .env and fill in
DATABASE_URL=./max.db
PORT=3030

# Anthropic API key — used by the LLM proxy. NOT shipped to the client.
# For dev, you can use your personal key. Production has its own.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Dev-only: shared bearer token clients send in `Authorization: Bearer <token>`.
# Replaced by real auth (Lucia / Auth0 / etc.) in the auth round.
DEV_TOKEN=local-dev-secret-change-me

# Optional: bootstrap email allowlist. Emails on this comma-separated
# list are auto-approved without going through the access-grants
# approval workflow. Useful for owner accounts.
# ALLOWED_EMAILS=neal@nealgoldstein.com

# v359.60.81: sign-in approval workflow.
# ADMIN_EMAIL — where new-sign-in-request notification emails are sent.
# When someone tries to sign in with an email not on ALLOWED_EMAILS and
# not yet in the access_grants table, this address gets an email with
# clickable Approve / Deny buttons.
# ADMIN_EMAIL=neal@nealgoldstein.com

# ADMIN_TOKEN — shared secret guarding POST /admin/revoke and
# GET /admin/grants. Pass as ?adminToken=... in the URL or via the
# X-Admin-Token header.
# ADMIN_TOKEN=replace-me-with-a-long-random-string
