# Local dev — copy to .env and fill in
DATABASE_URL=./max.db
PORT=3030

# Anthropic API key — used by the LLM proxy. NOT shipped to the client.
# For dev, you can use your personal key. Production has its own.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Dev-only: shared bearer token clients send in `Authorization: Bearer <token>`.
# Replaced by real auth (Lucia / Auth0 / etc.) in the auth round.
DEV_TOKEN=local-dev-secret-change-me
