{
  "// note": "Incremental JSDoc type-checking (#1). checkJs is OFF globally — a file opts IN with a top-line `// @ts-check`. So only annotated files are checked; the rest of the untyped codebase is untouched. Grow `include` as more files are typed. The shapes live in types/max-model.d.ts (ambient, no import needed).",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "es2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2020", "dom"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "types/**/*.d.ts",
    "decision-model.js",
    "migration.js",
    "engine-publish.js",
    "geography-model.js",
    "discovery-model.js",
    "max-data.js",
    "place-repo.js",
    "section-kind.js",
    "place-key.js",
    "engine-routing.js",
    "engine-enrich.js",
    "engine-build.js",
    "tripstore.js",
    "engine-trip.js",
    "construct-decorate.js",
    "apikey.js",
    "util-esc.js",
    "sync.js",
    "pm-docs-core.js",
    "map-pin-panel.js",
    "entry-point-map.js",
    "discovery-adapter.js",
    "menubar-phase.js",
    "exec-mode.js",
    "features-trip.js",
    "place-set.js",
    "max-merge.js",
    "gen-prompt.js",
    "gen-postprocess.js",
    "engine-geo.js",
    "engine-classify.js",
    "discovery-session.js",
    "discovery-persistence.js",
    "discovery-ingestion.js",
    "discovery-enhance.js",
    "db.js"
  ]
}
