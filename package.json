{
  "name": "max",
  "version": "1.0.0",
  "private": true,
  "description": "Max — The Existential Traveler. Type-checking + test scripts.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.js && node --check dist/app.bundle.js",
    "expose": "node tools/auto-expose.js",
    "expose:check": "node tools/auto-expose.js --check",
    "test": "bash tests/run.sh"
  },
  "devDependencies": {
    "acorn": "^8.17.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0"
  }
}
