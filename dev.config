# dev.config — single source of truth for the local dev loop.
#
# Read by BOTH:
#   • ./dev.sh                      (bash `source`)
#   • tests/playwright/playwright.config.js   (parsed at startup)
#
# Define the port ONCE here; everything else picks it up, so the preview
# server and the test runner can never drift onto different ports.
DEV_PORT=8765
